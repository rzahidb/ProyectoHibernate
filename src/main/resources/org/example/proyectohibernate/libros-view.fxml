<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.proyectohibernate.controller.LibroController"
           prefWidth="1000"
           prefHeight="650"
           style="-fx-background-color: #f0f0f0;">

    <VBox spacing="12"
          maxWidth="940"
          prefHeight="580"
          style="-fx-background-color: white;
                 -fx-border-color: #cccccc;">

        <padding>
            <Insets top="15" right="15"
                    bottom="15" left="15"/>
        </padding>

        <Label text="Registro de Libros"
               style="-fx-font-size: 18px;
                      -fx-font-weight: bold;"/>

        <GridPane hgap="10" vgap="10">

            <Label text="Título:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="0"/>

            <TextField fx:id="txtTitulo"
                       promptText="Título del libro"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0"/>

            <Label text="Autor:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="1"/>

            <TextField fx:id="txtAutor"
                       promptText="Autor del libro"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"/>

            <Label text="Año:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="2"/>

            <TextField fx:id="txtAnio"
                       promptText="Año de publicación"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"/>

            <Label text="Precio:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="3"/>

            <TextField fx:id="txtPrecio"
                       promptText="Precio del libro"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="3"/>

            <Label text="Categoría:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="4"/>

            <ComboBox fx:id="comboCategoria"
                      promptText="Seleccione una categoría"
                      prefWidth="240"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="4"/>

        </GridPane>

        <HBox spacing="8">

            <Button text="Guardar libro"
                    onAction="#guardarLibro"/>

            <Button text="Cargar libros"
                    onAction="#cargarLibros"/>

            <Button fx:id="btnModificar"
                    text="Modificar libro"
                    onAction="#modificarLibro"/>

            <Button fx:id="btnEliminar"
                    text="Eliminar libro"
                    onAction="#eliminarLibro"/>

            <Button text="Limpiar"
                    onAction="#limpiarCampos"/>

            <Button text="Actualizar categorías"
                    onAction="#cargarCategorias"/>

        </HBox>

        <TableView fx:id="tablaLibros"
                   editable="true"
                   VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="colId"
                             text="ID"
                             prefWidth="60"/>

                <TableColumn fx:id="colTitulo"
                             text="Título"
                             prefWidth="190"/>

                <TableColumn fx:id="colAutor"
                             text="Autor"
                             prefWidth="170"/>

                <TableColumn fx:id="colAnio"
                             text="Año"
                             prefWidth="90"/>

                <TableColumn fx:id="colPrecio"
                             text="Precio"
                             prefWidth="120"/>

                <TableColumn fx:id="colCategoria"
                             text="Categoría"
                             prefWidth="180"
                             editable="true"/>

            </columns>

        </TableView>

    </VBox>

</StackPane>
